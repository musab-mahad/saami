<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_attachment_form_r2_inherit" model="ir.ui.view">
        <field name="name">ir.attachment.form.inherit.r2.storage</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mimetype']" position="after">
                <field name="r2_direct_url"
                       widget="url"
                       readonly="1"
                       invisible="not r2_direct_url"
                       groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
