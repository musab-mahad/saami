<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="config_param_r2_fallback_local" model="ir.config_parameter">
            <field name="key">r2_storage.fallback_local</field>
            <field name="value">True</field>
        </record>
        <record id="config_param_r2_allow_delete" model="ir.config_parameter">
            <field name="key">r2_storage.allow_delete</field>
            <field name="value">True</field>
        </record>
    </data>

    <record id="ir_cron_r2_gc_queue" model="ir.cron">
        <field name="name">Cloudflare R2: Garbage Collect Unreferenced Objects</field>
        <field name="model_id" ref="model_r2_gc_queue"/>
        <field name="state">code</field>
        <field name="code">model._cron_gc_r2_objects()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
