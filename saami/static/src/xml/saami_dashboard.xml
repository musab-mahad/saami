<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="saami.Dashboard">
        <div class="o_action o_view_controller container-fluid py-4 px-4 overflow-auto" style="height: 100%;">
            <!-- Header with Title & Top-Right Filter -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold mb-1 text-primary">Saami Cooperative Overview</h2>
                    <p class="text-muted mb-0">Live summary of members, applications, and capital contributions</p>
                </div>

                <!-- Top Right Filter -->
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-semibold"><i class="fa fa-filter me-1"></i>Period:</span>
                    <select class="form-select form-select-sm shadow-sm" style="width: auto; min-width: 150px;" t-att-value="this.state.date_range" t-on-change="this._onDateRangeChange">
                        <option value="1_month">This Month</option>
                        <option value="3_months">Last 3 Months</option>
                        <option value="6_months">Last 6 Months</option>
                        <option value="1_year">This Year</option>
                        <option value="custom">Custom Range</option>
                    </select>
                    <div t-if="this.state.date_range === 'custom'" class="d-flex align-items-center gap-1 ms-2">
                        <input type="date" class="form-control form-control-sm" t-att-value="this.state.start_date" t-on-change="this._onCustomStartDateChange"/>
                        <span class="text-muted">-</span>
                        <input type="date" class="form-control form-control-sm" t-att-value="this.state.end_date" t-on-change="this._onCustomEndDateChange"/>
                    </div>
                </div>
            </div>

            <!-- Summary Cards Row -->
            <div class="row g-3 mb-4">
                <!-- Card 1: Active Members -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm border-0 h-100 rounded-3">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold small">Active Members</span>
                                <h3 class="fw-bold my-1 text-dark">
                                    <t t-esc="this.state.total_active_members"/>
                                </h3>
                                <span class="badge bg-success-subtle text-success small">Registered</span>
                            </div>
                            <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                                <i class="fa fa-users fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Pending Applications -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm border-0 h-100 rounded-3">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold small">Pending Applications</span>
                                <h3 class="fw-bold my-1 text-dark">
                                    <t t-esc="this.state.pending_applications"/>
                                </h3>
                                <span class="badge bg-warning-subtle text-warning small">Review Required</span>
                            </div>
                            <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                                <i class="fa fa-clock-o fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Total Contributed Capital -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm border-0 h-100 rounded-3">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold small">Total Contributed Capital</span>
                                <h3 class="fw-bold my-1 text-success">
                                    <t t-esc="this.state.currency"/> <t t-esc="this.formattedTotalContributions"/>
                                </h3>
                                <span class="badge bg-info-subtle text-info small">Cumulative Equity</span>
                            </div>
                            <div class="bg-success-subtle text-success p-3 rounded-circle">
                                <i class="fa fa-university fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Contributions in Period -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm border-0 h-100 rounded-3">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted text-uppercase fw-semibold small">Period Contributions</span>
                                <h3 class="fw-bold my-1 text-primary">
                                    <t t-esc="this.state.currency"/> <t t-esc="this.formattedPeriodContributions"/>
                                </h3>
                                <span class="badge bg-primary-subtle text-primary small">Selected Range</span>
                            </div>
                            <div class="bg-info-subtle text-info p-3 rounded-circle">
                                <i class="fa fa-money fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
