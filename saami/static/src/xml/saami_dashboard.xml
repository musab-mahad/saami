<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="saami.Dashboard">
        <div class="o_action o_view_controller container-fluid py-4 px-4 overflow-auto" style="height: 100%;">
            <!-- Header: Blank on Left, Filter Preserved Exactly as Ours on Top Right -->
            <div class="d-flex justify-content-end align-items-center mb-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-semibold"><i class="fa fa-filter me-1"></i>Period:</span>
                    <select class="form-select form-select-sm shadow-sm" style="width: auto; min-width: 150px;" t-att-value="this.state.date_range" t-on-change="this._onDateRangeChange">
                        <option value="1_month">This Month</option>
                        <option value="3_months">Last 3 Months</option>
                        <option value="6_months">Last 6 Months</option>
                        <option value="1_year">This Year</option>
                        <option value="custom">Custom Range</option>
                    </select>
                    <div t-if="this.state.date_range === 'custom'" class="d-flex align-items-center gap-1 ms-2">
                        <input type="date" class="form-control form-control-sm" t-att-value="this.state.start_date" t-on-change="this._onCustomStartDateChange"/>
                        <span class="text-muted">-</span>
                        <input type="date" class="form-control form-control-sm" t-att-value="this.state.end_date" t-on-change="this._onCustomEndDateChange"/>
                    </div>
                </div>
            </div>

            <!-- Summary Cards: OUR EXACT TITLES, ORDER, VALUES, ICONS, WITH CARD DESIGN COPIED -->
            <div class="row g-3 mb-4">
                <!-- Card 1: Active Members -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm bg-white h-100 p-3" style="border: 1px solid #e5e7eb !important; border-left: 5px solid #3b82f6 !important; border-radius: 0px !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Active Members</div>
                                <h2 class="fw-bold text-dark mb-1" style="font-size: 1.8rem;">
                                    <t t-esc="this.state.total_active_members"/>
                                </h2>
                                <div class="text-muted" style="font-size: 0.8rem;">Registered</div>
                            </div>
                            <div class="fs-1 text-primary opacity-50">
                                <i class="fa fa-users"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Pending Applications -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm bg-white h-100 p-3" style="border: 1px solid #e5e7eb !important; border-left: 5px solid #10b981 !important; border-radius: 0px !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Pending Applications</div>
                                <h2 class="fw-bold text-dark mb-1" style="font-size: 1.8rem;">
                                    <t t-esc="this.state.pending_applications"/>
                                </h2>
                                <div class="text-muted" style="font-size: 0.8rem;">Review Required</div>
                            </div>
                            <div class="fs-1 text-success opacity-50">
                                <i class="fa fa-clock-o"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Total Contributed Capital -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm bg-white h-100 p-3" style="border: 1px solid #e5e7eb !important; border-left: 5px solid #8b5cf6 !important; border-radius: 0px !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Contributed Capital</div>
                                <h2 class="fw-bold text-dark mb-1" style="font-size: 1.8rem;">
                                    <t t-esc="this.state.currency"/> <t t-esc="this.formattedTotalContributions"/>
                                </h2>
                                <div class="text-muted" style="font-size: 0.8rem;">Cumulative Equity</div>
                            </div>
                            <div class="fs-1 opacity-50" style="color: #8b5cf6 !important;">
                                <i class="fa fa-university"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Period Contributions -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card shadow-sm bg-white h-100 p-3" style="border: 1px solid #e5e7eb !important; border-left: 5px solid #f59e0b !important; border-radius: 0px !important;">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-uppercase fw-semibold text-muted mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">Period Contributions</div>
                                <h2 class="fw-bold text-dark mb-1" style="font-size: 1.8rem;">
                                    <t t-esc="this.state.currency"/> <t t-esc="this.formattedPeriodContributions"/>
                                </h2>
                                <div class="text-muted" style="font-size: 0.8rem;">Selected Range</div>
                            </div>
                            <div class="fs-1 text-warning opacity-50">
                                <i class="fa fa-money"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row: 2/3 Membership Growth + 1/3 Pending Application Statuses -->
            <div class="row g-3">
                <div class="col-12 col-lg-8">
                    <div class="card shadow-sm bg-white h-100 p-3" style="border: 1px solid #e5e7eb !important; border-radius: 0px !important;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="text-uppercase fw-semibold text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Membership Growth</div>
                                <div class="text-muted" style="font-size: 0.8rem;">Month-to-month new &amp; cumulative members</div>
                            </div>
                        </div>
                        <div t-ref="growthChart" style="min-height: 320px;"/>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="card shadow-sm bg-white h-100 p-3" style="border: 1px solid #e5e7eb !important; border-radius: 0px !important;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="text-uppercase fw-semibold text-muted" style="font-size: 0.75rem; letter-spacing: 0.5px;">Pending Applications</div>
                                <div class="text-muted" style="font-size: 0.8rem;">Breakdown by current status</div>
                            </div>
                        </div>
                        <div t-ref="statusPieChart" style="min-height: 320px;"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
