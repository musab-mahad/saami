<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Member Applications -->
        <record id="seq_saami_member_application" model="ir.sequence">
            <field name="name">Saami Member Application Sequence</field>
            <field name="code">saami.member.application</field>
            <field name="prefix">APL-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Approved Members -->
        <record id="seq_saami_member" model="ir.sequence">
            <field name="name">Saami Member Sequence</field>
            <field name="code">saami.member</field>
            <field name="prefix">SM-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Contribution Transactions -->
        <record id="seq_saami_contribution_transaction" model="ir.sequence">
            <field name="name">Saami Contribution Transaction Sequence</field>
            <field name="code">saami.contribution.transaction</field>
            <field name="prefix">TX-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
