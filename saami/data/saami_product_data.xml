<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Registration Fee Product (Type: Service, Revenue/Income) -->
        <record id="product_saami_registration_fee" model="product.product">
            <field name="name">Registration Fee</field>
            <field name="type">service</field>
            <field name="lst_price">50.00</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="categ_id" ref="product.product_category_services"/>
        </record>

        <!-- Monthly Contribution Product (Type: Service, Capital/Equity) -->
        <record id="product_saami_monthly_contribution" model="product.product">
            <field name="name">Monthly Contribution</field>
            <field name="type">service</field>
            <field name="lst_price">100.00</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="categ_id" ref="product.product_category_services"/>
        </record>

        <!-- Default Saami Product: Registration Fee -->
        <record id="saami_product_registration" model="saami.product">
            <field name="product_id" ref="product_saami_registration_fee"/>
            <field name="purpose">registration</field>
            <field name="amount">50.00</field>
            <field name="description">Cooperative Member Registration Fee</field>
            <field name="is_active" eval="True"/>
        </record>

        <!-- Default Saami Product: Monthly Contribution -->
        <record id="saami_product_contribution" model="saami.product">
            <field name="product_id" ref="product_saami_monthly_contribution"/>
            <field name="purpose">contribution</field>
            <field name="amount">100.00</field>
            <field name="description">Cooperative Member Monthly Contribution</field>
            <field name="is_active" eval="True"/>
        </record>
    </data>
</odoo>
