<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 1. Application Received Template -->
        <record id="mail_template_application_received" model="mail.template">
            <field name="name">Saami: Application Received</field>
            <field name="model_id" ref="saami.model_saami_member_application"/>
            <field name="subject">Welcome to Saami – Membership Application Received (#{{ object.name }})</field>
            <field name="email_from">"{{ object.env.company.name or 'Saami' }}" &lt;{{ object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user or object.env.company.partner_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.partner_id.email or object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user }}</field>
            <field name="email_to">{{ object.email or object.partner_id.email or (object.user_id and object.user_id.login) }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.full_name or object.first_name or 'there'"/>,</p>
                    <p>Thank you for applying to join the Saami Cooperative. We have successfully received your application (<strong>#<t t-out="object.name"/></strong>).</p>
                    <p>To proceed with your application, please login and complete the one-time registration fee payment of $<t t-out="f'{object.invoice_id.amount_total:,.2f}'"/> using mobile money.</p>
                    <p>Best regards,<br/><strong>The Saami Team</strong></p>
                </div>
            </field>
        </record>

        <!-- 2. Application Payment Received & Under Review Template -->
        <record id="mail_template_application_payment_received" model="mail.template">
            <field name="name">Saami: Payment Received &amp; Under Review</field>
            <field name="model_id" ref="saami.model_saami_member_application"/>
            <field name="subject">Payment Received – Your Saami Application is Under Review (#{{ object.name }})</field>
            <field name="email_from">"{{ object.env.company.name or 'Saami' }}" &lt;{{ object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user or object.env.company.partner_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.partner_id.email or object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user }}</field>
            <field name="email_to">{{ object.email or object.partner_id.email or (object.user_id and object.user_id.login) }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.full_name or object.first_name or 'there'"/>,</p>
                    <p>We have successfully received your registration fee payment of $<t t-out="f'{object.invoice_id.amount_total:,.2f}'"/> (Invoice: <strong><t t-out="object.invoice_id.name or ''"/></strong>).</p>
                    <p>Your application is now <strong>under review</strong> by our cooperative board. We will review your submitted information and notify you via email as soon as your membership is approved.</p>
                    <p>You can check your application status at any time by logging into the Saami app.</p>
                    <p>Best regards,<br/><strong>The Saami Team</strong></p>
                </div>
            </field>
        </record>

        <!-- 2b. Application Partial Payment Received Template -->
        <record id="mail_template_application_partial_payment_received" model="mail.template">
            <field name="name">Saami: Registration Installment Payment Received</field>
            <field name="model_id" ref="saami.model_saami_member_application"/>
            <field name="subject">Payment Received – Registration Fee Installment (#{{ object.name }})</field>
            <field name="email_from">"{{ object.env.company.name or 'Saami' }}" &lt;{{ object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user or object.env.company.partner_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.partner_id.email or object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user }}</field>
            <field name="email_to">{{ object.email or object.partner_id.email or (object.user_id and object.user_id.login) }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.full_name or object.first_name or 'there'"/>,</p>
                    <p>We have successfully received an installment payment towards your registration fee for application <strong>#<t t-out="object.name"/></strong> (Invoice: <strong><t t-out="object.invoice_id.name or ''"/></strong>).</p>
                    <p><strong>Payment Summary:</strong></p>
                    <ul>
                        <li><strong>Total Registration Fee:</strong> $<t t-out="f'{object.invoice_id.amount_total:,.2f}'"/></li>
                        <li><strong>Total Paid So Far:</strong> $<t t-out="f'{(object.invoice_id.amount_total - object.invoice_id.amount_residual):,.2f}'"/></li>
                        <li><strong>Remaining Balance Due:</strong> $<t t-out="f'{object.invoice_id.amount_residual:,.2f}'"/></li>
                    </ul>
                    <p>Please complete the remaining balance of $<t t-out="f'{object.invoice_id.amount_residual:,.2f}'"/> to submit your application for board review.</p>
                    <p>Best regards,<br/><strong>The Saami Team</strong></p>
                </div>
            </field>
        </record>

        <!-- 3. Application Approved Template -->
        <record id="mail_template_application_approved" model="mail.template">
            <field name="name">Saami: Application Approved</field>
            <field name="model_id" ref="saami.model_saami_member_application"/>
            <field name="subject">Congratulations! Your Saami Membership is Approved (#{{ object.member_id.name }})</field>
            <field name="email_from">"{{ object.env.company.name or 'Saami' }}" &lt;{{ object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user or object.env.company.partner_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.partner_id.email or object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user }}</field>
            <field name="email_to">{{ object.email or object.partner_id.email or (object.user_id and object.user_id.login) }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.full_name or object.first_name or 'there'"/>,</p>
                    <p>Congratulations! Your application for membership has been reviewed and <strong>approved</strong>.</p>
                    <p><strong>Your Official Member Details:</strong></p>
                    <ul>
                        <li><strong>Member Number:</strong> <t t-out="object.member_id.name"/></li>
                        <li><strong>Full Name:</strong> <t t-out="object.full_name"/></li>
                        <li><strong>Status:</strong> Active</li>
                    </ul>
                    <p>Your account is now fully active. You can log into the Saami app to view your profile and start making your monthly capital contributions.</p>
                    <p>Welcome to our community!</p>
                    <p>Best regards,<br/><strong>The Saami Team</strong></p>
                </div>
            </field>
        </record>

        <!-- 4. Contribution Payment Received Template -->
        <record id="mail_template_contribution_received" model="mail.template">
            <field name="name">Saami: Capital Contribution Received</field>
            <field name="model_id" ref="saami.model_saami_contribution_transaction"/>
            <field name="subject">Capital Contribution Received – {{ object.currency_id.symbol or '$' }}{{ f'{object.amount:,.2f}' }} (#{{ object.name }})</field>
            <field name="email_from">"{{ object.env.company.name or 'Saami' }}" &lt;{{ object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user or object.env.company.partner_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.partner_id.email or object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user }}</field>
            <field name="email_to">{{ object.member_id.email or object.partner_id.email or (object.member_id.user_id and object.member_id.user_id.login) }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.member_id.full_name or object.partner_id.name or 'there'"/>,</p>
                    <p>We have received your capital contribution payment. Thank you for your continued commitment!</p>
                    <p><strong>Payment Summary:</strong></p>
                    <ul>
                        <li><strong>Amount:</strong> <t t-out="object.currency_id.symbol or '$'"/><t t-out="f'{object.amount:,.2f}'"/></li>
                        <li><strong>Transaction Number:</strong> <t t-out="object.name"/></li>
                        <li t-if="object.tracker_id"><strong>Period:</strong> <t t-out="object.tracker_id.month_name"/></li>
                        <li><strong>Total Accumulated Contributions:</strong> <t t-out="object.currency_id.symbol or '$'"/><t t-out="f'{object.member_id.total_contributions:,.2f}'"/></li>
                    </ul>
                    <p>You can review your transaction history and tracker breakdown directly in the Saami app.</p>
                    <p>Best regards,<br/><strong>The Saami Team</strong></p>
                </div>
            </field>
        </record>

        <!-- 5. Application Rejected Template -->
        <record id="mail_template_application_rejected" model="mail.template">
            <field name="name">Saami: Application Rejected</field>
            <field name="model_id" ref="saami.model_saami_member_application"/>
            <field name="subject">Update Regarding Your Saami Membership Application (#{{ object.name }})</field>
            <field name="email_from">"{{ object.env.company.name or 'Saami' }}" &lt;{{ object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user or object.env.company.partner_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.partner_id.email or object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user }}</field>
            <field name="email_to">{{ object.email or object.partner_id.email or (object.user_id and object.user_id.login) }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.full_name or object.first_name or 'there'"/>,</p>
                    <p>Thank you for your interest in joining the Saami Cooperative.</p>
                    <p>After reviewing your application (<strong>#<t t-out="object.name"/></strong>), we were unable to approve your membership at this time.</p>
                    <p t-if="object.rejection_reason"><strong>Reason:</strong> <t t-out="object.rejection_reason"/></p>
                    <p>You may update your KYC details in the Saami app and resubmit your application for review.</p>
                    <p>Best regards,<br/><strong>The Saami Team</strong></p>
                </div>
            </field>
        </record>

        <!-- 6. Password Reset OTP Template -->
        <record id="mail_template_password_reset" model="mail.template">
            <field name="name">Saami: Password Reset Code</field>
            <field name="model_id" ref="saami.model_saami_password_reset"/>
            <field name="subject">Saami Password Reset Verification Code</field>
            <field name="email_from">"{{ object.env.company.name or 'Saami' }}" &lt;{{ object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user or object.env.company.partner_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.partner_id.email or object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user }}</field>
            <field name="email_to">{{ object.login_email or (object.user_id and object.user_id.login) }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.user_id.name or 'there'"/>,</p>
                    <p>We received a request to reset your Saami account password. Use the verification code below to set a new password:</p>
                    <p style="font-size: 24px; font-weight: bold; letter-spacing: 4px; margin: 16px 0;"><t t-out="ctx.get('otp_code', '')"/></p>
                    <p>This code expires in <strong>15 minutes</strong> and can only be used once.</p>
                    <p>If you did not request a password reset, you can safely ignore this email.</p>
                    <p>Best regards,<br/><strong>The Saami Team</strong></p>
                </div>
            </field>
        </record>

        <!-- 7. Email Verification OTP Template -->
        <record id="mail_template_email_verification" model="mail.template">
            <field name="name">Saami: Email Verification Code</field>
            <field name="model_id" ref="saami.model_saami_password_reset"/>
            <field name="subject">Verify Your Saami Email Address</field>
            <field name="email_from">"{{ object.env.company.name or 'Saami' }}" &lt;{{ object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user or object.env.company.partner_id.email }}&gt;</field>
            <field name="reply_to">{{ object.env.company.partner_id.email or object.env['ir.mail_server'].sudo().search([], limit=1).smtp_user }}</field>
            <field name="email_to">{{ object.login_email or (object.user_id and object.user_id.login) }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.user_id.name or 'there'"/>,</p>
                    <p>Welcome to Saami! Please verify your email address using the 6-digit code below:</p>
                    <p style="font-size: 24px; font-weight: bold; letter-spacing: 4px; margin: 16px 0;"><t t-out="ctx.get('otp_code', '')"/></p>
                    <p>This code expires in <strong>15 minutes</strong> and can only be used once.</p>
                    <p>Best regards,<br/><strong>The Saami Team</strong></p>
                </div>
            </field>
        </record>
    </data>
</odoo>
