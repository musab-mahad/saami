<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Monthly Cron to generate Contribution Trackers for all active members -->
        <record id="ir_cron_generate_monthly_contribution_trackers" model="ir.cron">
            <field name="name">Saami: Generate Monthly Contribution Trackers</field>
            <field name="model_id" ref="model_saami_contribution_tracker"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_trackers()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(datetime.now().replace(day=1)).strftime('%Y-%m-%d 00:05:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
