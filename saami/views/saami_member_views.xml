<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_saami_member_tree" model="ir.ui.view">
        <field name="name">saami.member.list</field>
        <field name="model">saami.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="name"/>
                <field name="full_name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="district_id"/>
                <field name="state_id"/>
                <field name="total_contributions" widget="monetary" sum="Total Contributions" width="150px"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'suspended'" decoration-danger="state == 'terminated'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_saami_member_form" model="ir.ui.view">
        <field name="name">saami.member.form</field>
        <field name="model">saami.member</field>
        <field name="arch" type="xml">
            <form string="Cooperative Member">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_suspend" string="Suspend" type="object" invisible="state != 'active'"/>
                    <button name="action_terminate" string="Terminate" type="object" invisible="state == 'terminated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,suspended,terminated"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contributions" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Contributions</span>
                                <field name="total_contributions" widget="monetary" class="o_stat_value"/>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_user" type="object" class="oe_stat_button" icon="fa-user" invisible="not user_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">User Account</span>
                                <span class="o_stat_value"><field name="user_id" options="{'no_open': True}" readonly="1"/></span>
                            </div>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar" options="{'preview_image': 'photo'}"/>
                    <div class="oe_title">
                        <label for="name" string="Member No."/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="full_name" placeholder="Full Name"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="first_name"/>
                            <field name="middle_name"/>
                            <field name="last_name"/>
                            <field name="mother_name"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="education_level"/>
                        </group>
                        <group string="Contact &amp; Location">
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="country_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="state_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="district_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="residence_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Next of Kin" name="kin">
                            <group>
                                <group string="First Next of Kin">
                                    <field name="kin1_name"/>
                                    <field name="kin1_mobile"/>
                                    <field name="kin1_address"/>
                                </group>
                                <group string="Second Next of Kin">
                                    <field name="kin2_name"/>
                                    <field name="kin2_mobile"/>
                                    <field name="kin2_address"/>
                                </group>
                            </group>
                        </page>
                        <page string="Banking Details" name="banking">
                            <group>
                                <group>
                                    <field name="bank_name"/>
                                    <field name="bank_account_no"/>
                                    <field name="bank_address"/>
                                </group>
                            </group>
                        </page>
                        <page string="KYC Documents" name="kyc">
                            <group>
                                <group>
                                    <field name="identity_file" filename="name"/>
                                </group>
                            </group>
                        </page>
                        <page string="Financial &amp; System" name="financial_system">
                            <group>
                                <group string="Contributions">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="total_contributions" widget="monetary"/>
                                </group>
                                <group string="Linked Records">
                                    <field name="partner_id" readonly="1"/>
                                    <field name="application_id" readonly="1"/>
                                    <label for="user_id" string="Portal User"/>
                                    <div class="o_row">
                                        <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                                        <button string="Create User"
                                                class="btn btn-link"
                                                type="object"
                                                name="action_create_user"
                                                invisible="user_id"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_saami_member_search" model="ir.ui.view">
        <field name="name">saami.member.search</field>
        <field name="model">saami.member</field>
        <field name="arch" type="xml">
            <search string="Search Members">
                <field name="name" string="Member No."/>
                <field name="full_name" string="Member Name"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="state_id"/>
                <field name="district_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_suspended" string="Suspended" domain="[('state', '=', 'suspended')]"/>
                <filter name="filter_terminated" string="Terminated" domain="[('state', '=', 'terminated')]"/>
                <separator/>
                <filter name="filter_male" string="Male" domain="[('gender', '=', 'male')]"/>
                <filter name="filter_female" string="Female" domain="[('gender', '=', 'female')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_state_id" string="Region" context="{'group_by': 'state_id'}"/>
                    <filter name="group_by_district" string="District" context="{'group_by': 'district_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Members -->
    <record id="action_saami_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">saami.member</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active members found!
            </p>
            <p>
                Approved applicants automatically become members of the cooperative here.
            </p>
        </field>
    </record>
</odoo>
