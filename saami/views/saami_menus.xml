<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Level Menu -->
    <menuitem id="menu_saami_root"
              name="Saami"
              sequence="10"
              web_icon="saami,static/description/icon.png"/>

    <!-- Operations / Management Submenu -->
    <menuitem id="menu_saami_membership"
              name="Membership"
              parent="menu_saami_root"
              sequence="10"/>

    <!-- Applications Menu -->
    <menuitem id="menu_saami_member_application"
              name="Applications"
              parent="menu_saami_membership"
              action="action_saami_member_application"
              sequence="10"/>

    <!-- Members Menu -->
    <menuitem id="menu_saami_member"
              name="Members"
              parent="menu_saami_membership"
              action="action_saami_member"
              sequence="20"/>

    <!-- Contributions Tracker Menu -->
    <menuitem id="menu_saami_contribution_tracker"
              name="Contributions Tracker"
              parent="menu_saami_membership"
              action="action_saami_contribution_tracker"
              sequence="30"/>

    <!-- Transactions Menu -->
    <menuitem id="menu_saami_contribution_transaction"
              name="Transactions"
              parent="menu_saami_membership"
              action="action_saami_contribution_transaction"
              sequence="40"/>

    <!-- Configuration Submenu -->
    <menuitem id="menu_saami_configuration"
              name="Configuration"
              parent="menu_saami_root"
              sequence="50"/>

    <!-- Saami Products Menu -->
    <menuitem id="menu_saami_product"
              name="Saami Products"
              parent="menu_saami_configuration"
              action="action_saami_product"
              sequence="10"/>
</odoo>
