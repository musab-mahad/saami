<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Level Menu -->
    <menuitem id="menu_saami_root"
              name="Saami"
              sequence="10"
              web_icon="saami,static/description/icon.png"/>

    <!-- Dashboard Menu (First Menu Item) -->
    <menuitem id="menu_saami_dashboard"
              name="Dashboard"
              parent="menu_saami_root"
              action="action_saami_dashboard"
              sequence="0"/>

    <!-- Operations / Management Submenu -->
    <menuitem id="menu_saami_membership"
              name="Membership"
              parent="menu_saami_root"
              sequence="10"/>

    <!-- Applications Menu -->
    <menuitem id="menu_saami_member_application"
              name="Applications"
              parent="menu_saami_membership"
              action="action_saami_member_application"
              sequence="10"/>

    <!-- Members Menu -->
    <menuitem id="menu_saami_member"
              name="Members"
              parent="menu_saami_membership"
              action="action_saami_member"
              sequence="20"/>

    <!-- Contributions Submenu -->
    <menuitem id="menu_saami_contributions"
              name="Contributions"
              parent="menu_saami_root"
              sequence="20"/>

    <!-- Contributions Tracker Menu (under Contributions) -->
    <menuitem id="menu_saami_contribution_tracker"
              name="Contributions Tracker"
              parent="menu_saami_contributions"
              action="action_saami_contribution_tracker"
              sequence="10"/>

    <!-- Transactions Menu (under Contributions) -->
    <menuitem id="menu_saami_contribution_transaction"
              name="Transactions"
              parent="menu_saami_contributions"
              action="action_saami_contribution_transaction"
              sequence="20"/>

    <!-- Configuration Submenu -->
    <menuitem id="menu_saami_configuration"
              name="Configuration"
              parent="menu_saami_root"
              sequence="50"/>

    <!-- Settings Menu (under Configuration) -->
    <menuitem id="menu_saami_settings"
              name="Settings"
              parent="menu_saami_configuration"
              action="action_saami_config_settings"
              sequence="0"
              groups="base.group_system"/>

    <!-- Saami Products Menu -->
    <menuitem id="menu_saami_product"
              name="Saami Products"
              parent="menu_saami_configuration"
              action="action_saami_product"
              sequence="10"/>

    <!-- Regions Menu -->
    <menuitem id="menu_saami_region"
              name="Regions"
              parent="menu_saami_configuration"
              action="action_saami_region"
              sequence="20"/>

    <!-- Districts Menu -->
    <menuitem id="menu_saami_district"
              name="Districts"
              parent="menu_saami_configuration"
              action="action_saami_district"
              sequence="30"/>
</odoo>
