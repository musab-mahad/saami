<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_saami_contribution_transaction_tree" model="ir.ui.view">
        <field name="name">saami.contribution.transaction.list</field>
        <field name="model">saami.contribution.transaction</field>
        <field name="arch" type="xml">
            <list string="Contribution Transactions" default_order="date desc, id desc">
                <field name="name"/>
                <field name="date"/>
                <field name="member_id"/>
                <field name="partner_id" optional="show"/>
                <field name="application_id" optional="hide"/>
                <field name="transaction_type" widget="badge"/>
                <field name="payment_method"/>
                <field name="external_reference"/>
                <field name="amount" widget="monetary" sum="Total Amount" width="150px"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-warning="state == 'pending'" decoration-danger="state == 'failed'" decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_saami_contribution_transaction_form" model="ir.ui.view">
        <field name="name">saami.contribution.transaction.form</field>
        <field name="model">saami.contribution.transaction</field>
        <field name="arch" type="xml">
            <form string="Contribution Transaction">
                <header>
                    <button name="action_mark_paid" string="Confirm Payment" type="object" class="oe_highlight" invisible="state == 'paid'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('paid', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Transaction Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Transaction Information">
                            <field name="member_id" readonly="state == 'paid'"/>
                            <field name="application_id" readonly="state == 'paid'"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="transaction_type" readonly="state == 'paid'"/>
                            <field name="tracker_id" readonly="state == 'paid'"/>
                        </group>
                        <group string="Payment Details">
                            <field name="date" readonly="state == 'paid'"/>
                            <field name="amount" widget="monetary" readonly="state == 'paid'"/>
                            <field name="processing_fee_percentage" readonly="1" invisible="not processing_fee_percentage"/>
                            <field name="processing_fee_amount" widget="monetary" readonly="1" invisible="not processing_fee_amount"/>
                            <field name="total_charged" widget="monetary" readonly="1" invisible="not total_charged"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_method" readonly="state == 'paid'"/>
                            <field name="payer_phone" readonly="1" invisible="not payer_phone"/>
                            <field name="external_reference" readonly="state == 'paid'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounting Links" name="accounting">
                            <group>
                                <group>
                                    <field name="invoice_id" readonly="1"/>
                                    <field name="payment_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_saami_contribution_transaction_search" model="ir.ui.view">
        <field name="name">saami.contribution.transaction.search</field>
        <field name="model">saami.contribution.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Transactions">
                <field name="name" string="Reference"/>
                <field name="member_id" string="Member"/>
                <field name="external_reference" string="Gateway Ref"/>
                <filter name="filter_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date:month'}"/>
                    <filter name="group_by_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'transaction_type'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_saami_contribution_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">saami.contribution.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_paid': 1}</field>
    </record>

    <!-- Inherit Payment Transaction Form to show Saami Processing Fee -->
    <record id="view_payment_transaction_form_saami_fee" model="ir.ui.view">
        <field name="name">payment.transaction.form.saami.fee</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="saami_payment_purpose" invisible="1"/>
                <field name="saami_base_amount" widget="monetary" readonly="1" invisible="not saami_base_amount"/>
                <field name="saami_processing_fee_percentage" readonly="1" invisible="not saami_processing_fee_percentage"/>
                <field name="saami_processing_fee_amount" widget="monetary" readonly="1" invisible="not saami_processing_fee_amount"/>
                <field name="saami_payer_phone" readonly="1" invisible="not saami_payer_phone"/>
            </xpath>
        </field>
    </record>
</odoo>
