<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_saami_product_tree" model="ir.ui.view">
        <field name="name">saami.product.list</field>
        <field name="model">saami.product</field>
        <field name="arch" type="xml">
            <list string="Saami Products">
                <field name="product_id"/>
                <field name="purpose" widget="badge" decoration-info="purpose == 'registration'" decoration-success="purpose == 'contribution'"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_saami_product_form" model="ir.ui.view">
        <field name="name">saami.product.form</field>
        <field name="model">saami.product</field>
        <field name="arch" type="xml">
            <form string="Saami Product">
                <sheet>
                    <group>
                        <group string="Product Details">
                            <field name="product_id"/>
                            <field name="purpose"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Pricing &amp; Invoicing">
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_saami_product" model="ir.actions.act_window">
        <field name="name">Saami Products</field>
        <field name="res_model">saami.product</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure a Saami Product!
            </p>
            <p>
                Set the active products and amounts used when generating invoices for registration fees and monthly capital contributions.
            </p>
        </field>
    </record>
</odoo>
