<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saami_reject_application_wizard_form" model="ir.ui.view">
        <field name="name">saami.reject.application.wizard.form</field>
        <field name="model">saami.reject.application.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Application">
                <group>
                    <field name="application_id" readonly="1"/>
                    <field name="reason" placeholder="Enter the reason for rejecting this application..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Rejection" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
