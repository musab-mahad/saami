<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_simulator" model="ir.ui.view">
        <field name="name">WaafiPay Provider Form Simulator Extension</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment_waafipay.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='WaafiPay Test Tools']" position="before">
                <group string="Simulator Engine">
                    <field name="waafipay_use_simulator" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
